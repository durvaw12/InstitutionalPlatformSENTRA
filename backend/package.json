{
  "name": "sentra-backend",
  "version": "1.0.0",
  "description": "Backend API for the Sentra Incident Reporting System (Express + native MongoDB driver + Cloudinary)",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed:resources": "node scripts/seedResources.js"
  },
  "engines": {
    "node": ">=18.11"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.12.0",
    "multer": "^2.0.2"
  }
}
